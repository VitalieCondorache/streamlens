{
  "name": "streamlens",
  "version": "0.1.0",
  "description": "Kafka, observed from the browser: an Angular 22 dashboard over a Node SSE bridge to a real Kafka 4.1 broker — live tail, partitions, consumer lag, offset replay and key partitioning.",
  "license": "MIT",
  "author": "Vitalie Condor (https://github.com/VitalieCondorache)",
  "homepage": "https://vitaliecondorache.github.io/streamlens/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitalieCondorache/streamlens.git"
  },
  "bugs": {
    "url": "https://github.com/VitalieCondorache/streamlens/issues"
  },
  "keywords": [
    "angular",
    "angular-signals",
    "zoneless",
    "kafka",
    "kafkajs",
    "server-sent-events",
    "consumer-lag",
    "offset-replay",
    "murmur2",
    "docker-compose",
    "playwright",
    "vitest"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:pages": "ng build --base-href ./",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:live": "E2E_LIVE_URL=http://localhost:4200 playwright test e2e/live-mode.spec.ts",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "screenshots": "npm run build && SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "screenshots:live": "SCREENSHOTS=1 E2E_LIVE_URL=http://localhost:4200 playwright test e2e/screenshots.spec.ts",
    "verify": "npm run lint && npm test -- --watch=false && npm run bff:test && npm run build && npm run test:e2e",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"bff/**/*.mjs\" \"e2e/**/*.ts\" \".github/workflows/*.yml\" playwright.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"bff/**/*.mjs\" \"e2e/**/*.ts\" \".github/workflows/*.yml\" playwright.config.ts",
    "bff": "npm --prefix bff start",
    "bff:test": "npm --prefix bff test",
    "bff:smoke": "npm --prefix bff run smoke",
    "bff:routes": "npm --prefix bff run routes:smoke",
    "capture": "npm --prefix bff run capture",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f bff",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.1",
    "@angular/cli": "^22.1.1",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "^4.0.8"
  }
}
